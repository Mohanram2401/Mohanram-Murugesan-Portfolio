# Firebase web config for the Aura Portfolio.
# Copy to .env.local and adjust, or leave unset to use the defaults baked into
# src/lib/firebase.ts (the live mohan-profile-beafa project).
VITE_FIREBASE_API_KEY=AIzaSyChgsyoRu-nA1-RJtMAZihJw2Gl_XmdHP0
VITE_FIREBASE_AUTH_DOMAIN=mohan-profile-beafa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mohan-profile-beafa
VITE_FIREBASE_STORAGE_BUCKET=mohan-profile-beafa.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=683130955395
VITE_FIREBASE_APP_ID=1:683130955395:web:f3e1839219f77f4e57ddb6

# Cloudinary free tier — used for photo & resume uploads (no Firebase Storage,
# so no paid Firebase plan needed).
#
# 1. Create a free account at https://cloudinary.com (no payment card required).
# 2. Copy your "Cloud name" from the dashboard.
# 3. Go to Settings → Upload → Upload presets → "Add upload preset".
# 4. Set "Signing mode" to "Unsigned" and name it (e.g. "aura_portfolio").
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
